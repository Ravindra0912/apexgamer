// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Game {
  id                  Int          @id @default(autoincrement())
  rId                 Int          @unique
  steamId             Int?
  name                String?
  backgroundImage     String?
  dominantColor       String?
  releaseDate         String?
  ratingMetacritic    Float?
  ratingRawg          Float?
  pros                String[]
  cons                String[]
  addedCount          Int?
  steamCcu            Int?
  steamOwnersLabel    String?
  steamPublisher      String?
  igdbPopularity      Float?
  trendingScore       Float?
  popularityUpdatedAt DateTime?
  category            GameCategory @default(UNCLASSIFIED)
  // RAWG platform names (PC, PlayStation 5, Nintendo Switch, ...) — the only
  // source here that covers consoles, since Steam only knows its own three.
  platforms           String[]
  // Parsed out of Steam's requirements HTML at ingest rather than stored raw,
  // so rendering never has to trust third-party markup:
  // { windows: { minimum: [{ label, value }], recommended: [...] }, mac, linux }
  systemRequirements  Json?
  // Set on every completed lookup, including ones that found nothing, so the
  // backfill can tell "not checked yet" from "checked, Steam had no data".
  requirementsUpdatedAt DateTime?
  // Gemini's digest of opinion-bearing comments across this game's review
  // videos: { sentiment, verdict, praised[], criticized[], opinionCount,
  // videoCount }. Null when there weren't enough real opinions to summarize
  // honestly (e.g. an unreleased game whose "review" videos are trailers).
  reviewCommentSummary   Json?
  // Stamped on every completed refresh, including ones that found too little
  // to summarize — YouTube API data may only be kept ~30 days before it must
  // be refreshed, so this drives the refresh script's staleness check.
  reviewCommentsUpdatedAt DateTime?
  // Daily pipeline bookkeeping. Each stage selects its work from these, so a
  // new game flows through every stage on its own, an interrupted run resumes
  // the next day, and an old game missing a feature gets backfilled by the
  // same code. Null means "never done".
  rawgSyncedAt         DateTime?
  steamReviewsSyncedAt DateTime?
  // Stamped on every gap-fill attempt, so a game whose search genuinely finds
  // nothing for a category isn't re-searched (100 quota units) every day.
  videoGuidesCheckedAt DateTime?
  reviews             Review[]
  screenshots         Screenshot[]
  tags                GameTag[]
  videoGuides         VideoGuide[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([updatedAt, id])
  @@index([trendingScore, id])
  @@index([addedCount, id])
}

enum GameCategory {
  AAA
  INDIE
  UNCLASSIFIED
}

model Review {
  id               Int     @id @default(autoincrement())
  gameId           Int
  game             Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reviewText       String?
  votesUp          Int?
  recommendationId String?

  @@index([gameId])
}

model Screenshot {
  id       Int     @id @default(autoincrement())
  gameId   Int
  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  remoteId Int?
  image    String?

  @@index([gameId])
}

model Tag {
  id              Int       @id
  name            String?
  slug            String?
  language        String?
  gamesCount      Int?
  imageBackground String?
  games           GameTag[]
}

model GameTag {
  gameId Int
  tagId  Int
  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
  @@index([tagId])
}

model VideoGuide {
  id          Int      @id @default(autoincrement())
  gameId      Int
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  youtubeId   String   @unique
  title       String
  channelName String?
  thumbnail   String?
  category    VideoGuideCategory
  // AI-generated blurb from the video's title/description only — never the
  // transcript, so nothing here is a creator's spoken content reproduced.
  aiSummary   String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  // YouTube API data may only be kept ~30 days before it's refreshed; the
  // pipeline re-reads title/channel/thumbnail when this goes stale.
  metadataRefreshedAt DateTime?
  comments    VideoComment[]

  @@index([gameId])
}

// Only comments Gemini judged to be an opinion of the game itself are stored —
// jokes, reactions to the reviewer and fact-checks of the video are dropped at
// ingest, so everything here is displayable.
model VideoComment {
  id               Int        @id @default(autoincrement())
  videoGuideId     Int
  videoGuide       VideoGuide @relation(fields: [videoGuideId], references: [id], onDelete: Cascade)
  youtubeCommentId String     @unique
  authorName       String?
  authorChannelUrl String?
  text             String
  likeCount        Int        @default(0)
  replyCount       Int        @default(0)
  stance           CommentStance
  // 1 = vague ("great game"), 2 = one concrete point, 3 = several points or a
  // reasoned argument. Display order is specificity first, then likes, so a
  // highly liked one-liner never outranks a substantive comment.
  specificity      Int
  publishedAt      DateTime?
  fetchedAt        DateTime   @default(now())

  @@index([videoGuideId])
}

// RAWG entries the pipeline decided not to add, so discovery stops offering
// them. Without this, a duplicate entry ranked high in RAWG ("MОUSE" with a
// Cyrillic О, a second listing of "MOUSE: P.I. For Hire") would be fetched,
// recognised by its Steam id and skipped again every day, taking one of the
// day's new-game slots each time.
model IgnoredRawgGame {
  rId       Int      @id
  name      String?
  reason    String
  steamId   Int?
  createdAt DateTime @default(now())
}

// One row per daily pipeline run: what each stage did and what went wrong,
// so a run's outcome can be checked without digging through CI logs.
model PipelineRun {
  id         Int               @id @default(autoincrement())
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  status     PipelineRunStatus @default(RUNNING)
  // { [stage]: { ...counts, durationMs, error? } }
  stats      Json?
  youtubeUnitsUsed Int         @default(0)
}

enum PipelineRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum CommentStance {
  POSITIVE
  NEGATIVE
  MIXED
}

enum VideoGuideCategory {
  REVIEW
  BEFORE_YOU_BUY
  GAMEPLAY
  NEW_PLAYER_GUIDE
}



